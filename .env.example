# Public host name the app is served on (used by Caddy for the HTTPS certificate)
DOMAIN=duties.example.org

# Shown in the app header and calendar exports
ORG_NAME=Duty Planning

# Initial admin account, created on first start only if no admin exists.
# You will be forced to change the password at first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Who can see mobile numbers: all | team (staff see their own team) | planners
MOBILE_VISIBILITY=team

# How dates in imported spreadsheets are written: dmy (31/12/2026) or mdy (12/31/2026)
DATE_ORDER=dmy

# First day of the leave year (MM-DD), used for annual leave allowances
LEAVE_YEAR_START=01-01
